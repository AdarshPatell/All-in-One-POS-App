<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.newchronopos.controller.GoodsReturnController"
      spacing="30.0" style="-fx-padding: 30;">
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #212529;" text="Goods Return" />

      <!-- Add New Goods Return Section -->
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #212529;" text="Goods Return Management" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="addGoodsReturnButton" style="-fx-background-color: #DC3545; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 10 20;" text="Process Return" />
         </children>
      </HBox>

      <!-- Goods Return Table -->
      <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #212529;" text="Recent Returns" />
                  <Region HBox.hgrow="ALWAYS" />
                  <TextField fx:id="searchField" promptText="Search returns..." style="-fx-background-radius: 20; -fx-padding: 8 15;" />
               </children>
            </HBox>

            <TableView fx:id="goodsReturnTable" prefHeight="400.0">
               <columns>
                  <TableColumn fx:id="returnNoColumn" text="Return No" prefWidth="120.0" />
                  <TableColumn fx:id="returnDateColumn" text="Date" prefWidth="100.0" />
                  <TableColumn fx:id="customerColumn" text="Customer" prefWidth="150.0" />
                  <TableColumn fx:id="reasonColumn" text="Reason" prefWidth="150.0" />
                  <TableColumn fx:id="totalAmountColumn" text="Refund Amount" prefWidth="120.0" />
                  <TableColumn fx:id="statusColumn" text="Status" prefWidth="100.0" />
                  <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="120.0" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
