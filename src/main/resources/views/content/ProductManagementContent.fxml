<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.newchronopos.controller.ProductManagementController"
      spacing="40.0" style="-fx-padding: 30;">
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #212529;" text="Product Management" />

      <!-- Product Management Module Cards with proper spacing -->
      <VBox spacing="20.0">
         <children>
            <GridPane hgap="30.0" vgap="30.0" alignment="CENTER">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <!-- Products Card -->
                  <VBox fx:id="productsButton" alignment="CENTER" spacing="15.0" style="-fx-background-color: #E9ECEF; -fx-background-radius: 15; -fx-padding: 30; -fx-cursor: hand;" GridPane.columnIndex="0">
                     <children>
                        <Label style="-fx-font-size: 32px; -fx-text-fill: #6C757D;" text="📦" />
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6C757D;" text="Products" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #6C757D;" text="68 Items" />
                     </children>
                  </VBox>

                  <!-- Categories Card (Active) -->
                  <VBox fx:id="categoriesButton" alignment="CENTER" spacing="15.0" style="-fx-background-color: #F4B942; -fx-background-radius: 15; -fx-padding: 30; -fx-cursor: hand;" GridPane.columnIndex="1">
                     <children>
                        <Label style="-fx-font-size: 32px; -fx-text-fill: white;" text="🏷️" />
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;" text="Categories" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: white;" text="12 Items" />
                     </children>
                  </VBox>

                  <!-- Suppliers Card -->
                  <VBox fx:id="suppliersButton" alignment="CENTER" spacing="15.0" style="-fx-background-color: #E9ECEF; -fx-background-radius: 15; -fx-padding: 30; -fx-cursor: hand;" GridPane.columnIndex="2">
                     <children>
                        <Label style="-fx-font-size: 32px; -fx-text-fill: #6C757D;" text="🏭" />
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6C757D;" text="Suppliers" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #6C757D;" text="8 Items" />
                     </children>
                  </VBox>

                  <!-- Brands Card -->
                  <VBox fx:id="brandsButton" alignment="CENTER" spacing="15.0" style="-fx-background-color: #E9ECEF; -fx-background-radius: 15; -fx-padding: 30; -fx-cursor: hand;" GridPane.columnIndex="3">
                     <children>
                        <Label style="-fx-font-size: 32px; -fx-text-fill: #6C757D;" text="🏷️" />
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6C757D;" text="Brands" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #6C757D;" text="15 Items" />
                     </children>
                  </VBox>

                  <!-- Units Card -->
                  <VBox fx:id="unitsButton" alignment="CENTER" spacing="15.0" style="-fx-background-color: #E9ECEF; -fx-background-radius: 15; -fx-padding: 30; -fx-cursor: hand;" GridPane.columnIndex="4">
                     <children>
                        <Label style="-fx-font-size: 32px; -fx-text-fill: #6C757D;" text="⚖️" />
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6C757D;" text="Units" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #6C757D;" text="10 Items" />
                     </children>
                  </VBox>
               </children>
            </GridPane>

            <!-- Add spacing after cards -->
            <Region prefHeight="30.0" />
         </children>
      </VBox>

      <!-- Content Area (this will be populated by navigation) -->
      <VBox fx:id="contentArea" spacing="20.0" style="-fx-padding: 20 0 0 0;">
         <!-- Dynamic content will be loaded here -->
      </VBox>

      <!-- Category Management Section -->
      <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #212529;" text="Categories" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="addNewCategoryButton" style="-fx-background-color: #F4B942; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 10 20;" text="Add New Category" />
               </children>
            </HBox>

            <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" style="-fx-background-color: transparent;">
               <content>
                  <HBox fx:id="categoriesContainer" spacing="15.0" style="-fx-padding: 5;">
                     <!-- Categories will be populated dynamically -->
                  </HBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</VBox>
