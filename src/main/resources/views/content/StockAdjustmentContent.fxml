<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.newchronopos.controller.StockAdjustmentController"
      spacing="30.0" style="-fx-padding: 30;">
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #212529;" text="Stock Adjustment" />

      <!-- Search and Filter Section -->
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <TextField fx:id="searchField" promptText="Search products..." style="-fx-background-radius: 20; -fx-padding: 8 15;" prefWidth="300.0" />
            <ComboBox fx:id="categoryFilter" promptText="Filter by Category" prefWidth="200.0" />
            <Button fx:id="resetFiltersButton" style="-fx-background-color: #6C757D; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 10 20;" text="Reset Filters" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="saveAdjustmentsButton" style="-fx-background-color: #28A745; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 10 20;" text="Save Adjustments" />
         </children>
      </HBox>

      <!-- Stock Adjustment Table -->
      <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #212529;" text="Product Stock Levels" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="selectedItemsLabel" style="-fx-font-size: 12px; -fx-text-fill: #6C757D;" text="0 items selected for adjustment" />
               </children>
            </HBox>

            <TableView fx:id="stockAdjustmentTable" prefHeight="400.0">
               <columns>
                  <TableColumn fx:id="selectColumn" text="" prefWidth="50.0" />
                  <TableColumn fx:id="productImageColumn" text="Image" prefWidth="80.0" />
                  <TableColumn fx:id="productNameColumn" text="Product Name" prefWidth="200.0" />
                  <TableColumn fx:id="itemIdColumn" text="Item ID" prefWidth="100.0" />
                  <TableColumn fx:id="categoryColumn" text="Category" prefWidth="120.0" />
                  <TableColumn fx:id="stockColumn" text="Current Stock" prefWidth="100.0" />
                  <TableColumn fx:id="adjustmentColumn" text="Adjustment" prefWidth="100.0" />
                  <TableColumn fx:id="newStockColumn" text="New Stock" prefWidth="100.0" />
                  <TableColumn fx:id="reasonColumn" text="Reason" prefWidth="150.0" />
                  <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="100.0" />
               </columns>
            </TableView>

            <!-- Bulk Actions -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Button fx:id="bulkIncreaseButton" style="-fx-background-color: #007BFF; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8 15;" text="Bulk Increase" />
                  <Button fx:id="bulkDecreaseButton" style="-fx-background-color: #DC3545; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8 15;" text="Bulk Decrease" />
                  <Button fx:id="exportReportButton" style="-fx-background-color: #17A2B8; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8 15;" text="Export Report" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
