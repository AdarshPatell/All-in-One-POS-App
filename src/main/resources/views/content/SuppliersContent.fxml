<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.newchronopos.controller.SuppliersController"
      spacing="30.0" style="-fx-padding: 30;">
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #212529;" text="Suppliers Management" />

      <!-- Add New Supplier Section -->
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #212529;" text="Supplier Management" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="addSupplierButton" style="-fx-background-color: #28A745; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 10 20;" text="Add New Supplier" />
         </children>
      </HBox>

      <!-- Suppliers Table -->
      <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #212529;" text="Suppliers List" />
                  <Region HBox.hgrow="ALWAYS" />
                  <TextField fx:id="searchField" promptText="Search suppliers..." style="-fx-background-radius: 20; -fx-padding: 8 15;" />
               </children>
            </HBox>

            <TableView fx:id="suppliersTable" prefHeight="400.0">
               <columns>
                  <TableColumn fx:id="supplierIdColumn" text="ID" prefWidth="80.0" />
                  <TableColumn fx:id="companyNameColumn" text="Company Name" prefWidth="200.0" />
                  <TableColumn fx:id="contactPersonColumn" text="Contact Person" prefWidth="150.0" />
                  <TableColumn fx:id="emailColumn" text="Email" prefWidth="150.0" />
                  <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="120.0" />
                  <TableColumn fx:id="statusColumn" text="Status" prefWidth="100.0" />
                  <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="120.0" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
