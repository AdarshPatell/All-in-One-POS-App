<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.newchronopos.controller.ProductsController"
      spacing="30.0" style="-fx-padding: 30;">
   <children>
      <!-- Categories Section -->
      <VBox spacing="15.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #212529;" text="Categories" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="addNewCategoryButton" style="-fx-background-color: #F4B942; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 10 20;" text="Add New Category" />
               </children>
            </HBox>

            <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" style="-fx-background-color: transparent;">
               <content>
                  <HBox fx:id="categoriesContainer" spacing="15.0" style="-fx-padding: 5;">
                     <!-- Categories will be populated dynamically -->
                  </HBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>

      <!-- Product Management Section -->
      <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
         <children>
            <!-- Product Tabs -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <HBox fx:id="productTabsContainer" spacing="10.0">
                     <!-- Product tabs will be populated dynamically -->
                  </HBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <TextField fx:id="searchField" promptText="Search products..." style="-fx-background-radius: 20; -fx-padding: 8 15;" />
                  <Button fx:id="addProductButton" style="-fx-background-color: #F4B942; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 10 20;" text="Add Product" />
               </children>
            </HBox>

            <!-- Product Grid -->
            <ScrollPane fx:id="productScrollPane" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent;">
               <content>
                  <GridPane fx:id="productGrid" hgap="20.0" vgap="20.0" style="-fx-padding: 10;">
                     <!-- Products will be populated dynamically -->
                  </GridPane>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</VBox>
