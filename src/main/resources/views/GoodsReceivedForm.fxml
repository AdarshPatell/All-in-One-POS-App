<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.newchronopos.controller.GoodsReceivedFormController" spacing="20.0" style="-fx-background-color: white; -fx-padding: 30;">
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #212529;" text="Goods Received Form" />

      <GridPane hgap="20.0" vgap="15.0">
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
            <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #495057;" text="Received Number" />
                  <TextField fx:id="receivedNumberField" promptText="Auto-generated" style="-fx-background-color: #F8F9FA; -fx-background-radius: 5; -fx-padding: 10;" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #495057;" text="Received Date" />
                  <DatePicker fx:id="receivedDatePicker" promptText="Select Date" style="-fx-background-color: #F8F9FA; -fx-background-radius: 5;" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #495057;" text="Supplier" />
                  <ComboBox fx:id="supplierCombo" prefWidth="200.0" promptText="Select Supplier" style="-fx-background-color: #F8F9FA; -fx-background-radius: 5;" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #495057;" text="Store Location" />
                  <ComboBox fx:id="storeLocationCombo" prefWidth="200.0" promptText="Select Location" style="-fx-background-color: #F8F9FA; -fx-background-radius: 5;" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #495057;" text="Total Amount" />
                  <TextField fx:id="totalAmountField" promptText="Enter Total Amount" style="-fx-background-color: #F8F9FA; -fx-background-radius: 5; -fx-padding: 10;" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #495057;" text="Status" />
                  <ComboBox fx:id="statusCombo" prefWidth="200.0" promptText="Select Status" style="-fx-background-color: #F8F9FA; -fx-background-radius: 5;" />
               </children>
            </VBox>

            <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #495057;" text="Remarks" />
                  <TextArea fx:id="remarksArea" prefRowCount="3" promptText="Enter remarks..." style="-fx-background-color: #F8F9FA; -fx-background-radius: 5;" />
               </children>
            </VBox>
         </children>
      </GridPane>

      <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 20 0 0 0;">
         <children>
            <Button fx:id="cancelButton" style="-fx-background-color: #E9ECEF; -fx-text-fill: #6C757D; -fx-background-radius: 5; -fx-padding: 10 20;" text="Cancel" />
            <Button fx:id="saveButton" style="-fx-background-color: #F4B942; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 10 20;" text="Save" />
         </children>
      </HBox>
   </children>
</VBox>
