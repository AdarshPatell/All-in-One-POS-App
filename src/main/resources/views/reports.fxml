<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #1c1c1e;" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.newchronopos.controller.ReportsController">

    <children>
        <HBox spacing="0" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">
            <!-- Sidebar -->
            <VBox prefWidth="200" style="-fx-background-color: #2d2d2d;">
                <padding>
                    <Insets top="20" left="15" right="15" bottom="20" />
                </padding>
                <children>
                    <Label text="CRONOPOS" textFill="white">
                        <font>
                            <Font size="20.0" />
                        </font>
                        <VBox.margin>
                            <Insets bottom="30" />
                        </VBox.margin>
                    </Label>

                    <Button text="Dashboard" styleClass="nav-btn" prefWidth="170" onAction="#navigateToDashboard"/>
                    <Button text="Transactions" styleClass="nav-btn" onAction="#navigateToTransactions"/>
                    <Button text="Products" styleClass="nav-btn" onAction="#navigateToProducts"/>
                    <Button text="Reports" styleClass="nav-btn-selected" onAction="#navigateToReports"/>
                    <Button text="Settings" styleClass="nav-btn" onAction="#navigateToSettings"/>

                    <VBox fx:id="logoutSection" alignment="BOTTOM_LEFT" spacing="10.0" VBox.vgrow="ALWAYS">
                        <Button text="Logout" styleClass="nav-btn" onAction="#handleLogout" />
                    </VBox>
                </children>
            </VBox>

            <!-- Main Content -->
            <VBox style="-fx-background-color: #1c1c1e;" HBox.hgrow="ALWAYS" spacing="20">
                <padding>
                    <Insets top="30" left="30" right="30" bottom="30" />
                </padding>
                <children>
                    <!-- Header -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Reports" textFill="white">
                            <font>
                                <Font size="26.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Generate Report" styleClass="action-btn" />
                        <Button text="Export Data" styleClass="action-btn" />
                    </HBox>

                    <!-- Reports Content -->
                    <VBox spacing="15" style="-fx-background-color: #2d2d2d; -fx-padding: 20; -fx-background-radius: 8;">
                        <Label text="Sales Reports" textFill="white" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                        
                        <GridPane hgap="15" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="100"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="100"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="100"/>
                            </columnConstraints>
                            
                            <!-- Daily Sales -->
                            <VBox spacing="10" style="-fx-background-color: #3d3d3d; -fx-padding: 15; -fx-background-radius: 5;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Daily Sales" textFill="white" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                <Label text="Coming Soon" textFill="#888888" style="-fx-font-size: 12px;"/>
                                <Button text="View Details" styleClass="nav-btn" style="-fx-pref-width: 100;"/>
                            </VBox>
                            
                            <!-- Weekly Sales -->
                            <VBox spacing="10" style="-fx-background-color: #3d3d3d; -fx-padding: 15; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Weekly Sales" textFill="white" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                <Label text="Coming Soon" textFill="#888888" style="-fx-font-size: 12px;"/>
                                <Button text="View Details" styleClass="nav-btn" style="-fx-pref-width: 100;"/>
                            </VBox>
                            
                            <!-- Monthly Sales -->
                            <VBox spacing="10" style="-fx-background-color: #3d3d3d; -fx-padding: 15; -fx-background-radius: 5;" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="Monthly Sales" textFill="white" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                <Label text="Coming Soon" textFill="#888888" style="-fx-font-size: 12px;"/>
                                <Button text="View Details" styleClass="nav-btn" style="-fx-pref-width: 100;"/>
                            </VBox>
                            
                            <!-- Product Reports -->
                            <VBox spacing="10" style="-fx-background-color: #3d3d3d; -fx-padding: 15; -fx-background-radius: 5;" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Product Reports" textFill="white" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                <Label text="Coming Soon" textFill="#888888" style="-fx-font-size: 12px;"/>
                                <Button text="View Details" styleClass="nav-btn" style="-fx-pref-width: 100;"/>
                            </VBox>
                            
                            <!-- Inventory Reports -->
                            <VBox spacing="10" style="-fx-background-color: #3d3d3d; -fx-padding: 15; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Inventory Reports" textFill="white" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                <Label text="Coming Soon" textFill="#888888" style="-fx-font-size: 12px;"/>
                                <Button text="View Details" styleClass="nav-btn" style="-fx-pref-width: 100;"/>
                            </VBox>
                            
                            <!-- Tax Reports -->
                            <VBox spacing="10" style="-fx-background-color: #3d3d3d; -fx-padding: 15; -fx-background-radius: 5;" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                <Label text="Tax Reports" textFill="white" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                <Label text="Coming Soon" textFill="#888888" style="-fx-font-size: 12px;"/>
                                <Button text="View Details" styleClass="nav-btn" style="-fx-pref-width: 100;"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- Additional Report Categories -->
                    <VBox spacing="15" style="-fx-background-color: #2d2d2d; -fx-padding: 20; -fx-background-radius: 8;">
                        <Label text="Analytics & Insights" textFill="white" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                        
                        <HBox spacing="15">
                            <VBox spacing="10" style="-fx-background-color: #3d3d3d; -fx-padding: 15; -fx-background-radius: 5;" HBox.hgrow="ALWAYS">
                                <Label text="Customer Analytics" textFill="white" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                <Label text="Customer behavior and preferences" textFill="#888888" style="-fx-font-size: 12px;"/>
                                <Button text="View Analytics" styleClass="nav-btn" style="-fx-pref-width: 120;"/>
                            </VBox>
                            
                            <VBox spacing="10" style="-fx-background-color: #3d3d3d; -fx-padding: 15; -fx-background-radius: 5;" HBox.hgrow="ALWAYS">
                                <Label text="Performance Metrics" textFill="white" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                <Label text="System and business performance" textFill="#888888" style="-fx-font-size: 12px;"/>
                                <Button text="View Metrics" styleClass="nav-btn" style="-fx-pref-width: 120;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </children>
            </VBox>
        </HBox>
    </children>
</AnchorPane>
